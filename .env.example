# Copia este fichero a .env y rellena los valores. .env nunca se sube a Git.

NODE_ENV=development
PORT=3000

# postgres://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ficheros

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

UPLOAD_DIR=./uploads
# 10 MB
MAX_FILE_SIZE_BYTES=10485760

# Intentos de login y registro por IP cada 15 minutos
AUTH_RATE_LIMIT_MAX=20

# Proxies delante de la API: 0 en local, 1 en Railway
TRUST_PROXY=0
